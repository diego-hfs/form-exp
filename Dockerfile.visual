FROM node:22-bookworm-slim
ENV DISPLAY=:99
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium fluxbox novnc websockify x11vnc xvfb x11-utils fonts-liberation ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY package.json ./
RUN npm install
COPY . .
RUN chmod +x /app/docker/start-visual.sh
EXPOSE 6080
CMD ["bash", "/app/docker/start-visual.sh"]
